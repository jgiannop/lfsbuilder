/work/
__pycache__/
*.pyc
.venv/

# A distribution's own logo and recipe are its owner's, kept on this PC only (back them up, with
# work/binhost/gnupg): only Argo's logo (the default) and the example recipes belong to the tool.
/branding/*
!/branding/argo/
# (Argo's own pictures only: those drawn for another label, a user's distribution with Argo's logo, are theirs)
/branding/argo/pictures/*
!/branding/argo/pictures/argo-linux/
/recipes/*
!/recipes/keys/
!/recipes/example.*
!/recipes/gnome.*
!/recipes/plasma.*
!/recipes/xfce.*
!/recipes/openrc.*
